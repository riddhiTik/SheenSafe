<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingHorizontal="24dp">

    <!-- Back arrow -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Go back"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/primary_dark" />

    <!-- Step label -->
    <TextView
        android:id="@+id/tvStepLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/onboarding_step_label"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:fontFamily="sans-serif" />

    <!-- Headline -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/onboarding_name_title"
        android:textColor="@color/text_main"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.1" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/onboarding_name_subtitle"
        android:textColor="@color/on_surface_variant"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.3"
        android:fontFamily="sans-serif"
        android:paddingHorizontal="8dp" />

    <!-- Input field -->
    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_input_field"
        android:hint="@string/onboarding_name_placeholder"
        android:inputType="textPersonName|textCapWords"
        android:paddingHorizontal="24dp"
        android:textColor="@color/text_main"
        android:textColorHint="@color/outline"
        android:textSize="18sp"
        android:fontFamily="sans-serif"
        android:imeOptions="actionDone"
        android:singleLine="true" />

    <!-- Privacy note -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/outline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/onboarding_name_privacy"
            android:textColor="@color/outline"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Continue button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:enabled="false"
        android:text="@string/onboarding_continue"
        android:textColor="@color/on_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        app:backgroundTint="@color/primary_dark"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_arrow_forward"
        app:iconGravity="end"
        app:iconTint="@color/on_primary" />

    <!-- Skip link -->
    <TextView
        android:id="@+id/tvSkip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:gravity="center"
        android:text="@string/onboarding_skip"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:background="?attr/selectableItemBackground" />

</LinearLayout>
