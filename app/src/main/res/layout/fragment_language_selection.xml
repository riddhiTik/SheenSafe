<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:gravity="center_horizontal">

            <!-- Avatar illustration -->
            <ImageView
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_marginBottom="32dp"
                android:background="@drawable/bg_avatar_circle"
                android:src="@drawable/ic_person_avatar"
                android:scaleType="fitCenter"
                android:padding="20dp"
                android:contentDescription="@null" />

            <!-- App name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:textAlignment="center"
                android:layout_marginBottom="8dp" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_tagline"
                android:textSize="16sp"
                android:textColor="@color/muted"
                android:textAlignment="center"
                android:layout_marginBottom="40dp" />

            <!-- Section label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_choose_language"
                android:textSize="12sp"
                android:textColor="@color/text_main"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:letterSpacing="0.15"
                android:layout_marginBottom="16dp" />

            <!-- English -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEnglish"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/card_stroke_default"
                app:strokeWidth="2dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lang_english_name"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_main" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lang_english_greeting"
                            android:textSize="14sp"
                            android:textColor="@color/muted" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/checkEnglish"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="invisible"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hindi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHindi"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/card_stroke_default"
                app:strokeWidth="2dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lang_hindi_name"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_main" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lang_hindi_greeting"
                            android:textSize="14sp"
                            android:textColor="@color/muted" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/checkHindi"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="invisible"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kashmiri -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardKashmiri"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/card_stroke_default"
                app:strokeWidth="2dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lang_kashmiri_name"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_main" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lang_kashmiri_greeting"
                            android:textSize="14sp"
                            android:textColor="@color/muted" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/checkKashmiri"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="invisible"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Urdu -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUrdu"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/card_stroke_default"
                app:strokeWidth="2dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lang_urdu_name"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_main" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/lang_urdu_greeting"
                            android:textSize="14sp"
                            android:textColor="@color/muted" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/checkUrdu"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="invisible"
                        android:contentDescription="@null" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Fixed bottom button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp"
        android:background="@color/background_light">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBeginJourney"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/onboarding_begin_journey"
            android:enabled="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_on_primary"
            app:cornerRadius="28dp"
            app:backgroundTint="@color/btn_primary_tint"
            app:rippleColor="#2019E661" />

    </LinearLayout>

</LinearLayout>
