<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:paddingHorizontal="24dp">

    <!-- Back arrow -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Go back"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/primary_dark" />

    <!-- Scan illustration — reduced from 240dp to 140dp -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp">

        <View
            android:id="@+id/outerRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pulse_ring" />

        <View
            android:id="@+id/middleRing"
            android:layout_width="105dp"
            android:layout_height="105dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_pulse_ring" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="center"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#33006E29">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_cell_tower"
                app:tint="@color/primary_dark" />
        </com.google.android.material.card.MaterialCardView>

        <View
            android:id="@+id/scanDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/bg_scan_dot" />
    </FrameLayout>

    <!-- Step label -->
    <TextView
        android:id="@+id/tvStepLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/primary_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        android:fontFamily="sans-serif" />

    <!-- Headline -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/onboarding_device_title"
        android:textColor="@color/text_main"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.1" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/onboarding_device_subtitle"
        android:textColor="@color/on_surface_variant"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.2"
        android:fontFamily="sans-serif" />

    <!-- Device card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_gender_card_default"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar_circle">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_watch"
                app:tint="@color/primary_dark" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_device_name"
                android:textColor="@color/text_main"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />

            <TextView
                android:id="@+id/tvDeviceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_device_status"
                android:textColor="@color/primary_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/primary_dark" />
    </LinearLayout>

    <!-- Scan status label -->
    <TextView
        android:id="@+id/tvScanStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="@color/primary_dark"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:visibility="gone" />

    <!-- BLE device list — expands to fill all remaining space -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDevices"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <!-- Spacer: fills space when list is hidden so buttons stay at bottom -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Hint -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="@string/onboarding_device_hint"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:textStyle="italic"
        android:fontFamily="sans-serif" />

    <!-- Scan button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/onboarding_scan_for_device"
        android:textColor="@color/on_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        app:backgroundTint="@color/primary_dark"
        app:cornerRadius="28dp" />

    <!-- Skip button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSkip"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:text="@string/onboarding_skip_device"
        android:textColor="@color/muted"
        android:textSize="15sp"
        android:fontFamily="sans-serif" />

</LinearLayout>
